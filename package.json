{
  "name": "buddy-relay",
  "displayName": "BuddyRelay - Multi-Account Switcher for CodeBuddy/WorkBuddy",
  "description": "Seamless multi-account manager & hot account switcher for CodeBuddy / WorkBuddy AI IDEs. Switch without restart, keep all sessions, quota guard, auto check-in & tasks, usage audit.",
  "version": "1.0.4",
  "publisher": "soulvon",
  "keywords": [
    "codebuddy",
    "workbuddy",
    "multi-account",
    "account switcher",
    "account manager",
    "ai ide",
    "quota",
    "check-in",
    "session",
    "automation",
    "多账号",
    "切号",
    "签到",
    "额度"
  ],
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#0f766e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soulvon/BuddyRelay"
  },
  "bugs": {
    "url": "https://github.com/soulvon/BuddyRelay/issues"
  },
  "homepage": "https://github.com/soulvon/BuddyRelay#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buddy-relay-sidebar",
          "title": "BuddyRelay",
          "icon": "resources/relay.svg"
        }
      ]
    },
    "views": {
      "buddy-relay-sidebar": [
        {
          "type": "webview",
          "id": "buddy-relay.sidebarView",
          "name": "BuddyRelay"
        }
      ]
    },
    "commands": [
      {
        "command": "buddy-relay.showAccountQuickPick",
        "title": "%command.quickPick.title%",
        "category": "BuddyRelay",
        "icon": "$(account)"
      },
      {
        "command": "buddy-relay.switchAccount",
        "title": "%command.switchAccount.title%",
        "category": "BuddyRelay",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "buddy-relay.checkin",
        "title": "%command.checkin.title%",
        "category": "BuddyRelay",
        "icon": "$(check)"
      },
      {
        "command": "buddy-relay.addAccountOAuth",
        "title": "%command.addAccountOAuth.title%",
        "category": "BuddyRelay",
        "icon": "$(add)"
      },
      {
        "command": "buddy-relay.importCockpit",
        "title": "%command.importCockpit.title%",
        "category": "BuddyRelay",
        "icon": "$(cloud-download)"
      },
      {
        "command": "buddy-relay.refreshStatus",
        "title": "%command.refreshStatus.title%",
        "category": "BuddyRelay",
        "icon": "$(refresh)"
      },
      {
        "command": "buddy-relay.deleteAccount",
        "title": "%command.deleteAccount.title%",
        "category": "BuddyRelay",
        "icon": "$(trash)"
      },
      {
        "command": "buddy-relay.checkUpdate",
        "title": "%command.checkUpdate.title%",
        "category": "BuddyRelay",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "buddy-relay.refreshStatus",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "buddy-relay.checkin",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@2"
        },
        {
          "command": "buddy-relay.importCockpit",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@3"
        },
        {
          "command": "buddy-relay.addAccountOAuth",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "%config.title%",
      "properties": {
        "buddyRelay.locale": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "enumDescriptions": [
            "%config.locale.auto%",
            "%config.locale.zh%",
            "%config.locale.en%"
          ],
          "default": "auto",
          "description": "%config.locale%"
        },
        "buddyRelay.autoCheckin": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoCheckin%"
        },
        "buddyRelay.refreshIntervalMinutes": {
          "type": "number",
          "default": 15,
          "description": "%config.refreshIntervalMinutes%"
        },
        "buddyRelay.cockpitEndpoint": {
          "type": "string",
          "default": "",
          "description": "%config.cockpitEndpoint%"
        },
        "buddyRelay.autoCheckin.dailyTime": {
          "type": "string",
          "default": "00:10",
          "description": "%config.autoCheckin.dailyTime%"
        },
        "buddyRelay.autoCheckin.randomJitterMinutes": {
          "type": "number",
          "default": 30,
          "description": "%config.autoCheckin.randomJitterMinutes%"
        },
        "buddyRelay.autoCheckin.perAccountDelaySeconds": {
          "type": "number",
          "default": 15,
          "description": "%config.autoCheckin.perAccountDelaySeconds%"
        },
        "buddyRelay.autoCheckin.startupMakeup": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoCheckin.startupMakeup%"
        },
        "buddyRelay.growthTasks.autoUseMakeupCard": {
          "type": "boolean",
          "default": true,
          "description": "%config.growthTasks.autoUseMakeupCard%"
        },
        "buddyRelay.autoSwitch.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoSwitch.enabled%"
        },
        "buddyRelay.autoSwitch.on429": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoSwitch.on429%"
        },
        "buddyRelay.autoSwitch.notifyOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoSwitch.notifyOnSwitch%"
        },
        "buddyRelay.privacyModeDefault": {
          "type": "boolean",
          "default": false,
          "description": "%config.privacyModeDefault%"
        },
        "buddyRelay.autoSwitch.quotaThresholdPercent": {
          "type": "number",
          "default": 10,
          "description": "%config.autoSwitch.quotaThresholdPercent%"
        },
        "buddyRelay.autoSwitch.strategy": {
          "type": "string",
          "enum": [
            "highest_quota",
            "lru",
            "round_robin",
            "health_priority"
          ],
          "enumDescriptions": [
            "%config.autoSwitch.strategy.highest_quota%",
            "%config.autoSwitch.strategy.lru%",
            "%config.autoSwitch.strategy.round_robin%",
            "%config.autoSwitch.strategy.health_priority%"
          ],
          "default": "highest_quota",
          "description": "%config.autoSwitch.strategy%"
        },
        "buddyRelay.autoSwitch.cooldownMinutes": {
          "type": "number",
          "default": 5,
          "description": "%config.autoSwitch.cooldownMinutes%"
        },
        "buddyRelay.growthTasks.autoAfterCheckin": {
          "type": "boolean",
          "default": true,
          "description": "%config.growthTasks.autoAfterCheckin%"
        },
        "buddyRelay.update.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "%config.update.autoCheck%"
        },
        "buddyRelay.update.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "%config.update.autoInstall%"
        },
        "buddyRelay.mainJsPath": {
          "type": "string",
          "default": "",
          "description": "%config.mainJsPath%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && node scripts/check_i18n_keys.mjs && node scripts/check_webview_injection.mjs && node scripts/check_ui_guards.mjs && node scripts/check_button_gates.mjs && node scripts/check_icon_gates.mjs && node scripts/test_growth_flow.mjs && node scripts/test_multiwindow_sync.mjs && node scripts/verify_card_actions_e2e.mjs && node scripts/test_v040_features.mjs",
    "compile": "tsc -p ./ && node -e \"const fs=require('fs'); fs.cpSync('out', 'dist', {recursive:true});\"",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile && node scripts/check_i18n_keys.mjs && node scripts/check_webview_injection.mjs && node scripts/check_ui_guards.mjs && node scripts/check_button_gates.mjs && node scripts/check_icon_gates.mjs && node scripts/test_growth_flow.mjs && node scripts/test_multiwindow_sync.mjs && node scripts/verify_card_actions_e2e.mjs && node scripts/test_v040_features.mjs",
    "package": "vsce package",
    "guard": "node scripts/check_ui_guards.mjs",
    "guard:i18n": "node scripts/check_i18n_keys.mjs",
    "check:release": "node scripts/check_release_readiness.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "adm-zip": "^0.6.1",
    "typescript": "^5.3.3"
  },
  "icon": "resources/icon.png"
}
