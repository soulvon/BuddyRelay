{
  "name": "buddy-relay",
  "displayName": "BuddyRelay",
  "description": "CodeBuddy / WorkBuddy（国内版/国际版）多账号管理与无感切号扩展，支持会话保留、额度守护与每日签到。",
  "version": "0.2.0",
  "publisher": "soulvon",
  "repository": {
    "type": "git",
    "url": "https://github.com/soulvon/BuddyRelay"
  },
  "bugs": {
    "url": "https://github.com/soulvon/BuddyRelay/issues"
  },
  "homepage": "https://github.com/soulvon/BuddyRelay#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buddy-relay-sidebar",
          "title": "BuddyRelay",
          "icon": "resources/relay.svg"
        }
      ]
    },
    "views": {
      "buddy-relay-sidebar": [
        {
          "type": "webview",
          "id": "buddy-relay.sidebarView",
          "name": "BuddyRelay"
        }
      ]
    },
    "commands": [
      {
        "command": "buddy-relay.showAccountQuickPick",
        "title": "快速切号菜单",
        "category": "BuddyRelay",
        "icon": "$(account)"
      },
      {
        "command": "buddy-relay.switchAccount",
        "title": "切换账号",
        "category": "BuddyRelay",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "buddy-relay.checkin",
        "title": "一键全员签到",
        "category": "BuddyRelay",
        "icon": "$(check)"
      },
      {
        "command": "buddy-relay.addAccountOAuth",
        "title": "添加账号(OAuth)",
        "category": "BuddyRelay",
        "icon": "$(add)"
      },
      {
        "command": "buddy-relay.importCockpit",
        "title": "从Cockpit导入",
        "category": "BuddyRelay",
        "icon": "$(cloud-download)"
      },
      {
        "command": "buddy-relay.refreshStatus",
        "title": "刷新状态与配额",
        "category": "BuddyRelay",
        "icon": "$(refresh)"
      },
      {
        "command": "buddy-relay.deleteAccount",
        "title": "删除账号",
        "category": "BuddyRelay",
        "icon": "$(trash)"
      },
      {
        "command": "buddy-relay.checkUpdate",
        "title": "检查新版本更新",
        "category": "BuddyRelay",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "buddy-relay.refreshStatus",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "buddy-relay.checkin",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@2"
        },
        {
          "command": "buddy-relay.importCockpit",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@3"
        },
        {
          "command": "buddy-relay.addAccountOAuth",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "BuddyRelay 配置",
      "properties": {
        "buddyRelay.autoCheckin": {
          "type": "boolean",
          "default": true,
          "description": "是否开启定时自动签到与领算力积分"
        },
        "buddyRelay.refreshIntervalMinutes": {
          "type": "number",
          "default": 15,
          "description": "账号状态与额度自动刷新间隔 (分钟)"
        },
        "buddyRelay.cockpitEndpoint": {
          "type": "string",
          "default": "",
          "description": "Cockpit 外部环境配置导入源地址"
        },
        "buddyRelay.autoCheckin.dailyTime": {
          "type": "string",
          "default": "00:10",
          "description": "每日自动签到时间（HH:mm，24 小时制）"
        },
        "buddyRelay.autoCheckin.randomJitterMinutes": {
          "type": "number",
          "default": 30,
          "description": "签到随机延迟窗口（分钟），错开整点更像真人操作"
        },
        "buddyRelay.autoCheckin.perAccountDelaySeconds": {
          "type": "number",
          "default": 15,
          "description": "多账号逐个签到之间的随机间隔上限（秒）"
        },
        "buddyRelay.autoSwitch.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用额度见底自动无感切换"
        },
        "buddyRelay.autoSwitch.quotaThresholdPercent": {
          "type": "number",
          "default": 10,
          "description": "当前账号剩余算力占比 ≤ 该百分比时自动切换到备用账号"
        },
        "buddyRelay.autoSwitch.strategy": {
          "type": "string",
          "enum": [
            "highest_quota",
            "lru",
            "round_robin",
            "health_priority"
          ],
          "enumDescriptions": [
            "优先剩余算力最多的账号",
            "最近最少使用优先",
            "按号池顺序轮换",
            "优先连续签到天数多的账号"
          ],
          "default": "highest_quota",
          "description": "自动切换时的候选账号挑选策略"
        },
        "buddyRelay.autoSwitch.cooldownMinutes": {
          "type": "number",
          "default": 5,
          "description": "两次自动切换之间的最小间隔（分钟），防止反复横跳"
        },
        "buddyRelay.growthTasks.autoAfterCheckin": {
          "type": "boolean",
          "default": true,
          "description": "每日自动签到完成后自动跑一轮成长任务（报名+领奖）"
        },
        "buddyRelay.update.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动在后台静默检查 GitHub 最新发布版本"
        },
        "buddyRelay.update.autoInstall": {
          "type": "boolean",
          "default": false,
          "description": "发现新版本时是否自动静默下载安装"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && node scripts/check_ui_guards.mjs && node scripts/check_button_gates.mjs && node scripts/check_icon_gates.mjs && node scripts/test_growth_flow.mjs",
    "compile": "tsc -p ./ && node -e \"const fs=require('fs'); fs.cpSync('out', 'dist', {recursive:true});\"",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile && node scripts/check_ui_guards.mjs && node scripts/check_button_gates.mjs && node scripts/check_icon_gates.mjs && node scripts/test_growth_flow.mjs",
    "package": "vsce package",
    "guard": "node scripts/check_ui_guards.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.3"
  },
  "icon": "resources/icon.png"
}