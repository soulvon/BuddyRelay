{
  "name": "buddy-relay",
  "displayName": "BuddyRelay",
  "description": "企业级工作区会话保护与多环境平滑轮换工具",
  "version": "0.1.0",
  "publisher": "enterprise",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buddy-relay-sidebar",
          "title": "BuddyRelay",
          "icon": "resources/relay.svg"
        }
      ]
    },
    "views": {
      "buddy-relay-sidebar": [
        {
          "type": "webview",
          "id": "buddy-relay.sidebarView",
          "name": "账号与会话中枢"
        }
      ]
    },
    "commands": [
      {
        "command": "buddy-relay.showAccountQuickPick",
        "title": "快速切号菜单",
        "category": "BuddyRelay",
        "icon": "$(account)"
      },
      {
        "command": "buddy-relay.switchAccount",
        "title": "切换账号",
        "category": "BuddyRelay",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "buddy-relay.checkin",
        "title": "一键全员签到",
        "category": "BuddyRelay",
        "icon": "$(check)"
      },
      {
        "command": "buddy-relay.addAccountOAuth",
        "title": "添加账号(OAuth)",
        "category": "BuddyRelay",
        "icon": "$(add)"
      },
      {
        "command": "buddy-relay.importCockpit",
        "title": "从Cockpit导入",
        "category": "BuddyRelay",
        "icon": "$(cloud-download)"
      },
      {
        "command": "buddy-relay.refreshStatus",
        "title": "刷新状态与配额",
        "category": "BuddyRelay",
        "icon": "$(refresh)"
      },
      {
        "command": "buddy-relay.deleteAccount",
        "title": "删除账号",
        "category": "BuddyRelay",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "buddy-relay.refreshStatus",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "buddy-relay.checkin",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@2"
        },
        {
          "command": "buddy-relay.importCockpit",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@3"
        },
        {
          "command": "buddy-relay.addAccountOAuth",
          "when": "view == buddy-relay.sidebarView",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "BuddyRelay 配置",
      "properties": {
        "buddyRelay.autoCheckin": {
          "type": "boolean",
          "default": true,
          "description": "是否开启定时自动签到与领算力积分"
        },
        "buddyRelay.refreshIntervalMinutes": {
          "type": "number",
          "default": 15,
          "description": "账号状态与额度自动刷新间隔 (分钟)"
        },
        "buddyRelay.cockpitEndpoint": {
          "type": "string",
          "default": "",
          "description": "Cockpit 外部环境配置导入源地址"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node -e \"const fs=require('fs'); fs.cpSync('out', 'dist', {recursive:true});\"",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.3"
  }
}
